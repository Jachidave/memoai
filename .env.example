# AuraNoted Clone - Environment Configuration
# Copy this file to .env.local and fill in your values

# AI Provider Configuration
NEXT_PUBLIC_AI_PROVIDER=local
NEXT_PUBLIC_AI_MODEL=llama3.2
NEXT_PUBLIC_AI_ENDPOINT=http://localhost:11434

# Optional: API keys for cloud providers (if using)
# OPENAI_API_KEY=your_openai_api_key
# ANTHROPIC_API_KEY=your_anthropic_api_key
# GOOGLE_API_KEY=your_google_api_key

# Transcription Service (optional)
# WHISPER_API_KEY=your_whisper_api_key
# TRANSCRIPTION_ENDPOINT=https://api.openai.com/v1/audio/transcriptions